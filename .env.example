# ---------------------------------------------------------------------------
# RecallAI environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
DEBUG=true
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- PostgreSQL + pgvector --------------------------------------------------
POSTGRES_DB=recallai
POSTGRES_USER=recallai
POSTGRES_PASSWORD=recallai
DATABASE_URL=postgres://recallai:recallai@postgres:5432/recallai

# --- Redis / Celery ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Run Celery tasks inline (no worker/Redis needed). Useful for quick local hacking only.
CELERY_TASK_ALWAYS_EAGER=false

# --- Local AI (Ollama) -------------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Must match the embedding model's output size (nomic-embed-text = 768).
EMBEDDING_DIMENSIONS=768
# Task prefixes recommended by nomic-embed-text. Leave blank for models that don't use them.
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_DOCUMENT_PREFIX="search_document: "
OLLAMA_REQUEST_TIMEOUT=300
# Context window passed to Ollama for generation.
OLLAMA_NUM_CTX=8192

# --- Retrieval / chunking ----------------------------------------------------
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=80
RAG_TOP_K=10
RAG_CONTEXT_CHUNKS=5
RAG_MIN_SCORE=0.3

# --- HTTP / security --------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
# Bytes. 25 MB default.
MAX_UPLOAD_SIZE=26214400

# --- Frontend ---------------------------------------------------------------
# URL the *browser* uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000
